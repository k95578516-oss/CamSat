# Copy to .env (never commit .env) and fill in. Spring Boot does not read .env by itself:
# on Windows run  scripts\run-dev.ps1  which loads it, or set the variables in your shell / service manager.

# Profile: dev (default, local-only defaults allowed) or prod (no defaults, fails fast if anything is missing)
SPRING_PROFILES_ACTIVE=dev

# --- Database (MySQL 8) ---
DB_URL=jdbc:mysql://localhost:3306/cam_sat?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=camsat
DB_PASSWORD=change-me

# --- JWT ---
# REQUIRED in prod: random, at least 32 characters. Generate one, e.g. PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
# In dev, if empty, a random per-process secret is used (all tokens become invalid after a restart).
JWT_SECRET=
JWT_EXPIRATION_SECONDS=3600

# --- HTTP ---
SERVER_PORT=8080
# Comma-separated list of exact origins allowed to call the API from a browser. Wildcards are rejected.
# Not needed when the frontend uses the Vite proxy (same-origin requests).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Simulation ---
# Wall-clock pause per simulated second so the UI can show progress / pause / cancel. 0 = as fast as possible.
SIM_SAMPLE_DELAY_MS=25
