# Base URL of the CamSat Spring Boot backend (no trailing slash).
# Leave EMPTY to send same-origin requests ("/api/...") and use the Vite dev proxy
# (dev) or a reverse proxy (production).
VITE_API_BASE_URL=http://localhost:8080

# Optional, dev server only: where the Vite proxy forwards "/api" when VITE_API_BASE_URL is empty.
DEV_PROXY_TARGET=http://localhost:8080

# Optional: request timeout (ms) for normal API calls. Starting a simulation uses a longer timeout.
VITE_API_TIMEOUT_MS=15000
VITE_SIMULATION_START_TIMEOUT_MS=180000

# NEVER put secrets in VITE_* variables: they are embedded in the public JavaScript bundle.
